{
  "name": "estrivisor",
  "productName": "Estrivisor",
  "version": "3.8.0",
  "description": "Estrivisor — voz, chat e compartilhamento de tela entre amigos",
  "author": "mateusdevtsr",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish always"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "livekit-client": "^2.5.0",
    "electron-updater": "^6.3.9",
    "discord-rpc": "^4.0.1"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.estrivisor.desktop",
    "productName": "Estrivisor",
    "files": [
      "main.js",
      "preload.js",
      "migrar-dados.js",
      "icone.png",
      "configuracao.js",
      "index.html",
      "estrivisor-app.js",
      ".env",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "icone.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Estrivisor-Setup.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "mateusdevtsr",
      "repo": "Estrivisor",
      "releaseType": "release"
    }
  }
}
