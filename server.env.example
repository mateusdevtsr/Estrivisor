# ATENÇÃO: copie para "server.env" e NUNCA envie este arquivo pra ninguém nem suba pro GitHub.
# Ele fica só no computador que roda o servidor e é lido pelo docker-compose.

# ---- LiveKit (o seu, na VPS: veja vps/LEIA-ME-VPS.md; as chaves são as do livekit.env da VPS) ----
LIVEKIT_URL=wss://livekit.SEU-DOMINIO
LIVEKIT_API_KEY=cole-a-api-key
LIVEKIT_API_SECRET=cole-o-api-secret

# ---- "Senha" do app ----
# A mesma que vai no .env do app (dentro do instalador). Pode trocar quando quiser.
INVITE_KEY=troque-por-uma-frase-so-sua

# ---- Login com Discord (discord.com/developers/applications > seu app > OAuth2) ----
# Client ID = o "Application ID" (o mesmo DISCORD_CLIENT_ID do .env do app).
DISCORD_CLIENT_ID=000000000000000000
# Client Secret: SÓ aqui, nunca no .env do app.
DISCORD_CLIENT_SECRET=cole-o-client-secret
# Endereço de retorno do login: igual ao cadastrado em OAuth2 > Redirects.
DISCORD_REDIRECT_URI=http://127.0.0.1:53134/callback

# ---- Painel de monitoramento (https://api.SEU-DOMINIO/painel), só para os administradores ----
# Cadastre este mesmo endereço em OAuth2 > Redirects (fica junto com o do app). Sem ele, o login do painel fica desligado.
PAINEL_REDIRECT_URI=https://api.SEU-DOMINIO/painel/retorno
# (Opcional) De onde vêm os números de downloads (dono/repositório no GitHub). "desligado" não consulta.
# GITHUB_REPO=mateusdevtsr/Estrivisor

# (Opcional) Versão mínima do app. Quem estiver numa versão mais antiga é barrado com a mensagem
# "Atualize o Estrivisor". Deixe em branco para aceitar qualquer versão. Só ligue depois que todo
# mundo tiver atualizado (o app só manda a versão a partir da 3.8.4).
# APP_VERSAO_MINIMA=3.8.4

# ---- Quem manda no Estrivisor ----
# IDs do Discord dos administradores, separados por vírgula (só números).
ADMIN_DISCORD_IDS=

# Só entra quem o administrador liberou (ligado por padrão). ACESSO_RESTRITO=0 desliga.
# ACESSO_RESTRITO=1

# 1 = quem ainda não aceitou os termos de uso não consegue usar o servidor.
EXIGIR_ACEITE=1
