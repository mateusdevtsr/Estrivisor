# Configuração do APP (copie para ".env"). Este arquivo vai DENTRO do instalador,
# então não coloque aqui nada que só o servidor pode saber (Client Secret, chaves do LiveKit).

# Endereço do LiveKit Cloud (o mesmo LIVEKIT_URL do server.env).
LIVEKIT_URL=wss://seu-projeto.livekit.cloud

# Endereço do servidor do Estrivisor pelo túnel da Cloudflare (HTTPS).
TOKEN_SERVER_URL=https://api.seu-dominio.com

# A mesma INVITE_KEY do server.env.
INVITE_KEY=troque-por-uma-frase-so-sua

# Application ID do seu app no Discord (login e o status "Jogando Estrivisor").
DISCORD_CLIENT_ID=000000000000000000

# Endereço de retorno do login (igual ao cadastrado no Discord e no server.env). Opcional.
DISCORD_REDIRECT_URI=http://127.0.0.1:53134/callback
