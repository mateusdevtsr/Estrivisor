{
  "name": "concord-desktop-pro",
  "version": "1.0.0",
  "description": "App Electron de compartilhamento de tela via LiveKit",
  "author": "mateusdevtsr",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish always"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "livekit-client": "^2.5.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.concord.desktop",
    "productName": "Concord",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      ".env",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "mateusdevtsr",
      "repo": "Concord"
    }
  }
}
