{
  "name": "estrivisor",
  "productName": "Estrivisor",
  "version": "3.15.1",
  "description": "Estrivisor — voz, chat e compartilhamento de tela entre amigos",
  "author": "mateusdevtsr",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test testes/flutuante.test.js testes/estilo.test.js testes/areas.test.js testes/sons.test.js testes/ruido.test.js testes/arquivos.test.js testes/novidades.test.js testes/espectadores.test.js testes/desenho.test.js testes/social.test.js testes/perfil.test.js testes/somboard.test.js testes/cinema.test.js testes/imagens.test.js testes/caminhos.test.js testes/anuncio.test.js",
    "dist": "electron-builder --publish always"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "livekit-client": "^2.5.0",
    "electron-updater": "^6.3.9",
    "discord-rpc": "^4.0.1"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.estrivisor.desktop",
    "productName": "Estrivisor",
    "files": [
      "main.js",
      "preload.js",
      "migrar-dados.js",
      "icone.png",
      "configuracao.js",
      "flutuante.js",
      "estilo.js",
      "areas.js",
      "sons.js",
      "ruido.js",
      "arquivos.js",
      "novidades.js",
      "espectadores.js",
      "desenho.js",
      "social.js",
      "perfil.js",
      "somboard.js",
      "cinema.js",
      "imagens.js",
      "ruido/ruido-pacote.js",
      "flutuante.html",
      "flutuante.css",
      "flutuante-tela.js",
      "preload-flutuante.js",
      "index.html",
      "estrivisor-app.js",
      ".env",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "icone.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Estrivisor-Setup.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "mateusdevtsr",
      "repo": "Estrivisor",
      "releaseType": "release"
    }
  }
}
